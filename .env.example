# SmartPack — Environment Variables Template
# Instructions:
# 1. Copy this file to '.env.local'
# 2. In your Supabase Dashboard: Go to Project Settings -> API
# 3. Copy the 'Project URL' and paste it as VITE_SUPABASE_URL
# 4. Copy the 'anon public' API Key and paste it as VITE_SUPABASE_ANON_KEY
# 
# SECURITY WARNING:
# - NEVER put your 'service_role' secret key or database password in this file or any frontend file.
# - Only the 'anon public' key is safe for client-side applications.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
